diff --git a/src/open-thread.test.ts b/src/open-thread.test.ts
new file mode 100644
index 0000000..996312a
--- /dev/null
+++ b/src/open-thread.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  PANE_KEEPER_OPEN_THREAD_EVENT,
+  openThreadFromNotification,
+} from "./open-thread";
+
+describe("openThreadFromNotification", () => {
+  it("navigates when nothing is listening", () => {
+    const navigate = vi.fn();
+    openThreadFromNotification("thr_1", navigate, new EventTarget());
+    expect(navigate).toHaveBeenCalledWith("thr_1");
+  });
+
+  it("leaves the thread to Pane Keeper when it claims the event", () => {
+    const target = new EventTarget();
+    const seen: unknown[] = [];
+    target.addEventListener(PANE_KEEPER_OPEN_THREAD_EVENT, (event) => {
+      seen.push((event as CustomEvent).detail);
+      event.preventDefault();
+    });
+    const navigate = vi.fn();
+    openThreadFromNotification("thr_2", navigate, target);
+    expect(seen).toEqual([{ threadId: "thr_2" }]);
+    expect(navigate).not.toHaveBeenCalled();
+  });
+
+  it("still navigates when a listener lets the event pass", () => {
+    const target = new EventTarget();
+    target.addEventListener(PANE_KEEPER_OPEN_THREAD_EVENT, () => undefined);
+    const navigate = vi.fn();
+    openThreadFromNotification("thr_3", navigate, target);
+    expect(navigate).toHaveBeenCalledWith("thr_3");
+  });
+});
diff --git a/src/open-thread.ts b/src/open-thread.ts
new file mode 100644
index 0000000..bc67aea
--- /dev/null
+++ b/src/open-thread.ts
@@ -0,0 +1,27 @@
+// A notification click offers the thread to the Pane Keeper plugin first,
+// which opens it beside the focused split pane rather than over it. Without
+// Pane Keeper, or with its notificationClicks setting off, nothing claims the
+// event and the click navigates exactly as before.
+
+/**
+ * Pane Keeper listens for this on `window` and calls `preventDefault()` once
+ * it has opened the thread.
+ */
+export const PANE_KEEPER_OPEN_THREAD_EVENT = "pane-keeper:open-thread";
+
+export function openThreadFromNotification(
+  threadId: string,
+  navigateToThread: (threadId: string) => void,
+  target: EventTarget | undefined = typeof window === "undefined"
+    ? undefined
+    : window,
+): void {
+  if (target !== undefined) {
+    const event = new CustomEvent(PANE_KEEPER_OPEN_THREAD_EVENT, {
+      detail: { threadId },
+      cancelable: true,
+    });
+    if (!target.dispatchEvent(event)) return;
+  }
+  navigateToThread(threadId);
+}
